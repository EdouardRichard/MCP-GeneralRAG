{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "memory-management.schema.json",
  "type": "object",
  "properties": {
    "scope_id": {"type": "integer"},
    "memory_id": {"type": "integer"},
    "event_id": {"type": "integer"},
    "target": {"enum": ["relation", "vector", "links", "digest", "file", "salience", "all"]},
    "reason": {"type": "string"},
    "impact": {"type": "object"},
    "before_fingerprint": {"type": "string"},
    "after_fingerprint": {"type": "string"}
  },
  "required": ["scope_id"]
}
