{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mcp-recall-memory.input.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["scope_ref"],
  "properties": {
    "scope_ref": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "query": {"type": ["string", "null"], "maxLength": 2000},
    "memory_ids": {"type": ["array", "null"], "items": {"type": "integer"}},
    "kind": {"type": ["string", "null"], "enum": ["episodic", "semantic", "procedural", null]},
    "session_id": {"type": ["string", "null"], "format": "uuid"},
    "agent_id": {"type": ["string", "null"]},
    "time_window": {"type": ["object", "null"]},
    "as_of": {"type": ["string", "null"], "format": "date-time"},
    "include_superseded": {"type": "boolean", "default": false},
    "include_delivered": {"type": "boolean", "default": false},
    "limit": {"type": "integer", "minimum": 1, "maximum": 50, "default": 10}
  }
}
