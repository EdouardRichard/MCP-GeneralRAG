{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-engineering-rag-mcp.local/schemas/007/mcp-search-output.schema.json",
  "title": "search_knowledge Output Schema (007)",
  "description": "主检索 Tool 输出结构（007 扩展）。错误码枚举只增不删（新增 MISSING_KNOWLEDGE_SCOPE / AMBIGUOUS_DOMAIN_REF）；candidates 增量添加可选 scope_type/domain_key/slug（旧码响应字节级保持 1.0 形态）。",
  "type": "object",
  "properties": {
    "completion_status": {
      "type": "string",
      "enum": [
        "complete",
        "partial",
        "no_evidence",
        "failed"
      ],
      "description": "检索完成状态（四态）"
    },
    "evidence": {
      "type": "array",
      "description": "核心证据列表，按相关性排序",
      "items": {
        "type": "object",
        "properties": {
          "evidence_id": {
            "type": "string",
            "description": "证据唯一标识"
          },
          "content_excerpt": {
            "type": "string",
            "maxLength": 500,
            "description": "证据摘录"
          },
          "source_version": {
            "type": "integer",
            "minimum": 1,
            "description": "知识源版本号"
          },
          "source_position": {
            "type": "string",
            "description": "来源位置路径"
          },
          "knowledge_scope_id": {
            "type": "string",
            "pattern": "^[0-9]+$",
            "minLength": 1,
            "description": "知识域标识"
          },
          "knowledge_scope_type": {
            "$ref": "common.schema.json#/definitions/KnowledgeScopeType",
            "description": "知识域类型"
          },
          "relevance_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "相关性分数"
          }
        },
        "required": [
          "evidence_id",
          "content_excerpt",
          "source_version",
          "source_position",
          "knowledge_scope_id",
          "knowledge_scope_type",
          "relevance_score"
        ],
        "additionalProperties": false
      }
    },
    "gaps": {
      "type": "array",
      "description": "明确证据缺口（partial 时非空）",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "suggested_action": {
            "type": "string"
          }
        },
        "required": [
          "description"
        ],
        "additionalProperties": false
      }
    },
    "error": {
      "type": "object",
      "description": "错误信息（failed 或引用解析失败时存在）",
      "properties": {
        "code": {
          "$ref": "common.schema.json#/definitions/KnowledgeScopeErrorCode"
        },
        "message": {
          "type": "string",
          "description": "人类可读错误描述"
        },
        "candidates": {
          "type": "array",
          "description": "AMBIGUOUS_PROJECT_REF / AMBIGUOUS_DOMAIN_REF 时的候选列表",
          "items": {
            "$ref": "common.schema.json#/definitions/ScopeCandidate"
          }
        }
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false
    },
    "request_id": {
      "type": "string",
      "description": "请求唯一标识"
    }
  },
  "required": [
    "completion_status",
    "evidence",
    "request_id"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "completion_status": {
            "const": "partial"
          }
        }
      },
      "then": {
        "required": [
          "gaps"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "completion_status": {
            "const": "failed"
          }
        }
      },
      "then": {
        "required": [
          "error"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "completion_status": {
            "const": "no_evidence"
          }
        }
      },
      "then": {
        "properties": {
          "evidence": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
