{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-engineering-rag-mcp.local/schemas/007/mcp-search-input.schema.json",
  "title": "search_knowledge Input Schema (007)",
  "description": "主检索 Tool 输入参数（007 扩展）。新增可选 domain_scope；project_scope 与 domain_scope 至少一个非空（anyOf 表达，入口层显式校验并集非空补位）。旧客户端仅传 project_scope 行为逐字节不变。",
  "type": "object",
  "properties": {
    "query": {
      "type": "string",
      "description": "自然语言查询或事实性问题",
      "minLength": 1,
      "maxLength": 2000
    },
    "project_scope": {
      "type": "array",
      "description": "显式项目作用域（兼容形式）。稳定 ID、别名或仓库路径；不提供 domain_scope 时至少一个。",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "maxItems": 10
    },
    "domain_scope": {
      "type": "array",
      "description": "显式知识域作用域（新形式）。数字 knowledge_scope_id / scope slug / type:name；与 project_scope 并集去重后进入统一解析器。",
      "items": {
        "$ref": "common.schema.json#/definitions/KnowledgeDomainReference"
      },
      "minItems": 1,
      "maxItems": 10
    },
    "task_context": {
      "type": "object",
      "description": "可选任务上下文",
      "properties": {
        "current_file": {
          "type": "string",
          "description": "当前正在编辑的文件路径"
        },
        "current_symbol": {
          "type": "string",
          "description": "当前关注的符号名称"
        },
        "work_phase": {
          "type": "string",
          "enum": [
            "requirements",
            "design",
            "implementation",
            "testing",
            "review"
          ],
          "description": "当前工作阶段"
        },
        "additional_context": {
          "type": "string",
          "description": "额外上下文信息",
          "maxLength": 4000
        }
      },
      "additionalProperties": false
    },
    "top_k": {
      "type": "integer",
      "description": "返回最大证据条数。默认 5，最大 20。",
      "default": 5,
      "minimum": 1,
      "maximum": 20
    }
  },
  "required": [
    "query"
  ],
  "anyOf": [
    {
      "required": [
        "project_scope"
      ]
    },
    {
      "required": [
        "domain_scope"
      ]
    }
  ],
  "additionalProperties": false
}
