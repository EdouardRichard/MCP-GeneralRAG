{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rag-mcp:013:distiller-output:1",
  "title": "MemoryDistiller output v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["proposals"],
  "properties": {
    "proposals": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/proposal"}}
  },
  "$defs": {
    "memoryRef": {
      "type": "object", "additionalProperties": false,
      "required": ["memory_id", "source_event_id", "state_event_id", "content_hash"],
      "properties": {
        "memory_id": {"type": "integer", "minimum": 1},
        "source_event_id": {"type": "integer", "minimum": 1},
        "state_event_id": {"type": "integer", "minimum": 1},
        "content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "endpoint": {
      "oneOf": [
        {"$ref": "#/$defs/memoryRef"},
        {"$ref": "#/$defs/batchOutputRef"},
        {"type": "object", "additionalProperties": false, "required": ["local"], "properties": {"local": {"const": "output"}}}
      ]
    },
    "batchOutputRef": {
      "type": "object", "additionalProperties": false, "required": ["proposal_ref"],
      "properties": {"proposal_ref": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"}}
    },
    "targetRef": {"oneOf": [{"$ref": "#/$defs/memoryRef"}, {"$ref": "#/$defs/batchOutputRef"}]},
    "link": {
      "type": "object", "additionalProperties": false,
      "required": ["from_ref", "to_ref", "relation_type", "confidence", "description"],
      "properties": {
        "from_ref": {"$ref": "#/$defs/endpoint"},
        "to_ref": {"$ref": "#/$defs/endpoint"},
        "relation_type": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,62}$"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "description": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    },
    "context": {
      "type": "object", "additionalProperties": false,
      "required": ["context_digest", "keywords"],
      "properties": {
        "context_digest": {"type": "string", "minLength": 1, "maxLength": 1024},
        "keywords": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 64}}
      }
    },
    "common": {
      "type": "object",
      "required": ["proposal_id", "action", "source_refs", "confidence", "justification", "evidence_refs"],
      "properties": {
        "proposal_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
        "action": {"type": "string"},
        "source_refs": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/memoryRef"}},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "justification": {"type": "string", "minLength": 1, "maxLength": 4000},
        "evidence_refs": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "pattern": "^[1-9][0-9]*$"}},
        "link_suggestions": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/link"}},
        "context": {"$ref": "#/$defs/context"}
      }
    },
    "extractFact": {
      "allOf": [
        {"$ref": "#/$defs/common"},
        {"type": "object", "required": ["kind", "content"], "properties": {
          "action": {"const": "extract_fact"}, "kind": {"const": "semantic"},
          "content": {"type": "string", "minLength": 1, "maxLength": 4000},
          "title": {"type": "string", "maxLength": 512}
        }}
      ], "unevaluatedProperties": false
    },
    "distillProcedure": {
      "allOf": [
        {"$ref": "#/$defs/common"},
        {"type": "object", "required": ["kind", "content"], "properties": {
          "action": {"const": "distill_procedure"}, "kind": {"const": "procedural"},
          "content": {"type": "string", "minLength": 1, "maxLength": 4000},
          "title": {"type": "string", "maxLength": 512}
        }}
      ], "unevaluatedProperties": false
    },
    "mergeDuplicate": {
      "allOf": [
        {"$ref": "#/$defs/common"},
        {"type": "object", "required": ["survivor_ref", "duplicate_refs", "equivalence_basis"], "properties": {
          "action": {"const": "merge_duplicate"},
          "survivor_ref": {"$ref": "#/$defs/targetRef"},
          "duplicate_refs": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/targetRef"}},
          "equivalence_basis": {"type": "string", "minLength": 1, "maxLength": 4000}
        }}
      ], "unevaluatedProperties": false
    },
    "invalidateContradiction": {
      "allOf": [
        {"$ref": "#/$defs/common"},
        {"type": "object", "required": ["target_ref", "correcting_ref", "contradiction_basis"], "properties": {
          "action": {"const": "invalidate_contradiction"},
          "target_ref": {"$ref": "#/$defs/targetRef"},
          "correcting_ref": {"oneOf": [{"$ref": "#/$defs/targetRef"}, {"type": "null"}]},
          "contradiction_basis": {"type": "string", "minLength": 1, "maxLength": 4000}
        }}
      ], "unevaluatedProperties": false
    },
    "proposal": {"oneOf": [
      {"$ref": "#/$defs/extractFact"}, {"$ref": "#/$defs/distillProcedure"},
      {"$ref": "#/$defs/mergeDuplicate"}, {"$ref": "#/$defs/invalidateContradiction"}
    ]}
  }
}
