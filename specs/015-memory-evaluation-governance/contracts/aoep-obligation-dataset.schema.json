{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-engineering-rag-mcp.local/schemas/015/aoep-obligation-dataset.schema.json",
  "title": "AOEP Obligation Case Dataset Schema (015)",
  "description": "AOEP 状态义务用例契约（Q46）。五条不变量（依《宪法》XIII 第三条：权威单调、范围不扩张、删除传播、provenance 保全、回滚可溯）各 ≥2 个可独立执行的用例。判据为机器可判定：可溯 = 权威日志回滚事件存在且事件链闭合（回放 id 序列与权威日志逐项相等、无缺失、无重复——event_id 为 snowflake，MUST NOT 实现为数值连续性）+ 前后逐投影指纹比对 + 影响面计数一致；全传播 = 关系/向量/链接/摘要/文件五投影各自独立断言『该条可消费命中数 = 0』且各自分母非零，分母为零记不可测量而非达标。",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "dataset_version": { "type": "string", "pattern": "^015\\." },
    "frozen": {
      "type": "object",
      "properties": {
        "budget": { "type": "string", "minLength": 1 },
        "clock": { "type": "string", "minLength": 1 },
        "implementation": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "policy": { "type": "string", "minLength": 1 },
        "prompt": { "type": "string", "minLength": 1 },
        "recall": { "type": "string", "minLength": 1 },
        "schema": { "type": "string", "minLength": 1 },
        "snapshot": { "type": "string", "minLength": 1 },
        "vocabulary": { "type": "string", "minLength": 1 }
      },
      "required": ["budget", "clock", "implementation", "model", "policy", "prompt", "recall", "schema", "snapshot", "vocabulary"],
      "additionalProperties": { "type": "string" }
    },
    "snapshot_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "scope_id": { "type": "string", "minLength": 1, "description": "数据集声明的基准域（沿 014 连续性数据集先例）。破坏性操作不在该域执行，实际执行域为每次运行新建的专用隔离域（见 isolation 与逐例 isolated_scope_id）。" },
    "isolation": {
      "type": "object",
      "description": "隔离决议：破坏性操作（回滚、墓碑化、清理）只在每次运行新建的专用隔离域与隔离身份内执行，MUST NOT 作用于既有真实域或既有固定评测集依赖的域；隔离范围标识与运行后处置 MUST 留记录。",
      "properties": {
        "mode": { "const": "per_run_dedicated" },
        "identity": { "const": "per_run_dedicated" },
        "forbidden_scope_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "description": "既有固定评测集依赖的域 id（013/014 共用 scope 366084747748704256 / slug c013-eval-meeting-notes 为必列项）。"
        },
        "disposal": { "const": "record_and_dispose" },
        "record_isolation_id": { "const": true }
      },
      "required": ["mode", "identity", "forbidden_scope_ids", "disposal", "record_isolation_id"],
      "additionalProperties": false
    },
    "invariants": {
      "type": "object",
      "properties": {
        "traceable_rollback": { "$ref": "#/$defs/invariantDecl", "properties": { "min_cases": { "const": 2 } } },
        "deletion_propagation": { "$ref": "#/$defs/invariantDecl", "properties": { "min_cases": { "const": 2 } } },
        "authority_monotonicity": { "$ref": "#/$defs/invariantDecl", "properties": { "min_cases": { "const": 2 } } },
        "provenance_preservation": { "$ref": "#/$defs/invariantDecl", "properties": { "min_cases": { "const": 2 } } },
        "scope_non_expansion": { "$ref": "#/$defs/invariantDecl", "properties": { "min_cases": { "const": 2 } } }
      },
      "required": ["traceable_rollback", "deletion_propagation", "authority_monotonicity", "provenance_preservation", "scope_non_expansion"],
      "additionalProperties": false
    },
    "cases": {
      "type": "array",
      "minItems": 10,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "required": ["dataset_version", "frozen", "snapshot_hash", "scope_id", "isolation", "invariants", "cases"],
  "$defs": {
    "invariantDecl": {
      "type": "object",
      "properties": {
        "min_cases": { "type": "integer", "minimum": 2 },
        "machine_criterion": { "enum": ["R6.1", "R6.2", "R6.3", "R6.4", "R6.5", "R6.6"], "description": "R6.5 = 权威单调；R6.6 = provenance 保全（本次新增，前四码沿用既有判据编号）。" },
        "statement": { "type": "string", "minLength": 1 }
      },
      "required": ["min_cases", "machine_criterion"],
      "additionalProperties": false
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "case_id": { "type": "string", "pattern": "^aoep_[a-z0-9_]+$" },
        "invariant": { "enum": ["traceable_rollback", "deletion_propagation", "authority_monotonicity", "provenance_preservation", "scope_non_expansion"] },
        "target_kind": { "enum": ["event_point", "time_point", "action", "command"] },
        "requires_re_rollback": { "type": "boolean" },
        "projections_asserted": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["relation", "dense", "links", "summary", "file"] }
        },
        "expected": {
          "type": "object",
          "properties": { "outcome": { "const": "passed" } },
          "required": ["outcome"],
          "additionalProperties": false
        },
        "_meta": {
          "type": "object",
          "properties": {
            "review_status": { "enum": ["reviewed"] },
            "review_notes": { "type": "string", "minLength": 1 },
            "grounded_source": { "type": "string", "minLength": 1 }
          },
          "required": ["review_status", "review_notes", "grounded_source"],
          "additionalProperties": true
        }
      },
      "required": ["case_id", "invariant", "target_kind", "expected", "_meta"]
    }
  },
  "allOf": [
    {
      "description": "FR-014：五条不变量各 ≥2 个用例（依《宪法》XIII 第三条）。",
      "properties": {
        "cases": {
          "allOf": [
            { "contains": { "properties": { "invariant": { "const": "traceable_rollback" } }, "required": ["invariant"] }, "minContains": 2 },
            { "contains": { "properties": { "invariant": { "const": "deletion_propagation" } }, "required": ["invariant"] }, "minContains": 2 },
            { "contains": { "properties": { "invariant": { "const": "authority_monotonicity" } }, "required": ["invariant"] }, "minContains": 2 },
            { "contains": { "properties": { "invariant": { "const": "provenance_preservation" } }, "required": ["invariant"] }, "minContains": 2 },
            { "contains": { "properties": { "invariant": { "const": "scope_non_expansion" } }, "required": ["invariant"] }, "minContains": 2 }
          ]
        }
      }
    },
    {
      "description": "FR-015：时间点与事件点回滚各 ≥1 例；≥1 例验证可再次回滚。",
      "properties": {
        "cases": {
          "allOf": [
            { "contains": { "properties": { "invariant": { "const": "traceable_rollback" }, "target_kind": { "const": "event_point" } }, "required": ["invariant", "target_kind"] }, "minContains": 1 },
            { "contains": { "properties": { "invariant": { "const": "traceable_rollback" }, "target_kind": { "const": "time_point" } }, "required": ["invariant", "target_kind"] }, "minContains": 1 },
            { "contains": { "properties": { "invariant": { "const": "traceable_rollback" }, "requires_re_rollback": { "const": true } }, "required": ["invariant", "requires_re_rollback"] }, "minContains": 1 }
          ]
        }
      }
    },
    {
      "description": "FR-016：删除传播用例必须列出全部五类投影（关系/向量/链接/摘要/文件）。",
      "properties": {
        "cases": {
          "items": {
            "if": { "properties": { "invariant": { "const": "deletion_propagation" } }, "required": ["invariant"] },
            "then": {
              "properties": {
                "projections_asserted": {
                  "type": "array",
                  "minItems": 5,
                  "items": { "enum": ["relation", "dense", "links", "summary", "file"] }
                }
              },
              "required": ["projections_asserted"]
            }
          }
        }
      }
    }
  ]
}
