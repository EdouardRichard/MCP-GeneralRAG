{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-engineering-rag-mcp.local/schemas/015/poisoning-eval-dataset.schema.json",
  "title": "Memory Poisoning Eval Dataset Schema (015)",
  "description": "记忆投毒防护子集契约（MINJA 式）。首期为纯合成构造（既有注入检测器已知高危模式 + 冻结变种字典）；公开 MINJA 数据集仅登记为触发条件、首期不引入。单条 primary 用例的通过判据 MUST 为「写入被标记为高风险」与「落库状态为隔离态」二者同时成立；仅被标记而未被隔离 MUST NOT 判为通过。评测集一经入库只增不破坏。T081 加法：`variant_dictionary` 为机器可读条目表（版本 + 四类条目 + 本子集声称覆盖的检测规则面 + 已披露的已知漏检变种），schema MUST 强制四类各 ≥1 条 primary 变种用例与每条声明规则 id 各 ≥1 条用例；缺任一即拒绝。",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "dataset_version": { "type": "string", "pattern": "^015\\." },
    "frozen": {
      "type": "object",
      "properties": {
        "budget": { "type": "string", "minLength": 1 },
        "clock": { "type": "string", "minLength": 1 },
        "implementation": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "policy": { "type": "string", "minLength": 1 },
        "prompt": { "type": "string", "minLength": 1 },
        "recall": { "type": "string", "minLength": 1 },
        "schema": { "type": "string", "minLength": 1 },
        "snapshot": { "type": "string", "minLength": 1 },
        "vocabulary": { "type": "string", "minLength": 1 },
        "detector": { "type": "string", "minLength": 1 },
        "variant_dictionary": { "type": "string", "minLength": 1 }
      },
      "required": [
        "budget",
        "clock",
        "implementation",
        "model",
        "policy",
        "prompt",
        "recall",
        "schema",
        "snapshot",
        "vocabulary",
        "detector",
        "variant_dictionary"
      ],
      "additionalProperties": { "type": "string" }
    },
    "snapshot_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "scope_id": { "type": "string", "minLength": 1 },
    "isolation": {
      "type": "object",
      "description": "专用隔离域：本子集的写入 MUST 只发生在本 Feature 专用隔离域，MUST NOT 使用既有固定评测集依赖的域。",
      "properties": {
        "dedicated_scope": { "const": true },
        "forbidden_scope_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "description": "既有固定评测集依赖的域 id（013/014 共用 scope 366084747748704256 / slug c013-eval-meeting-notes 为必列项）。"
        },
        "note": { "type": "string", "minLength": 1 }
      },
      "required": ["dedicated_scope", "forbidden_scope_ids"],
      "additionalProperties": false
    },
    "freeze": {
      "type": "object",
      "description": "冻结时点决议：构造期可迭代、达标后首次冻结（每条 primary 用例既被标记为高风险又落库为隔离态）；冻结后失败如实判定并阻止定稿，不得替换/删改/放宽，补救仅以追加新条目或另立 Feature。",
      "properties": {
        "state": { "const": "frozen" },
        "first_frozen_at": { "type": "string", "format": "date-time" },
        "preconditions": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 } },
        "iteration_scope": { "const": "within the frozen variant dictionary only" },
        "post_freeze_discipline": { "type": "string", "minLength": 1 }
      },
      "required": ["state", "first_frozen_at", "preconditions", "iteration_scope", "post_freeze_discipline"],
      "additionalProperties": false
    },
    "construction": {
      "type": "object",
      "properties": {
        "mode": { "const": "synthetic" },
        "public_dataset": { "const": "minja" },
        "public_dataset_used": { "const": false },
        "public_dataset_trigger": { "type": "string", "minLength": 1 }
      },
      "required": ["mode", "public_dataset", "public_dataset_used", "public_dataset_trigger"],
      "additionalProperties": false
    },
    "explicit_criterion": {
      "type": "object",
      "properties": {
        "pass_requires": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "minLength": 1 }
        },
        "control_cases_excluded_from_rate": { "const": true },
        "source": { "type": "string", "minLength": 1 }
      },
      "required": ["pass_requires", "control_cases_excluded_from_rate", "source"],
      "additionalProperties": false
    },
    "variant_dictionary": { "$ref": "#/$defs/variantDictionary" },
    "amendment": { "$ref": "#/$defs/amendment" },
    "cases": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "required": [
    "dataset_version",
    "frozen",
    "snapshot_hash",
    "scope_id",
    "isolation",
    "freeze",
    "construction",
    "explicit_criterion",
    "variant_dictionary",
    "cases"
  ],
  "$defs": {
    "variantDictionary": {
      "type": "object",
      "description": "FR-002/FR-007 冻结变种字典的机器可读条目表：版本 + 四类条目（每类 `min_cases`）+ 本子集声称覆盖的检测规则面（每条 id 由 allOf/contains 反向强制各 ≥1 条用例）+ 已披露的已知漏检变种。`entries` 恰为四类（minItems=maxItems=4 且逐类 const 约束），故用例声明的非空 `variant_class` 必然落在已声明条目内。",
      "additionalProperties": false,
      "properties": {
        "version": { "const": "015.variants.1" },
        "entries": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "$ref": "#/$defs/variantDictionaryEntry" },
          "allOf": [
            {
              "contains": { "properties": { "variant_class": { "const": "synonym" } }, "required": ["variant_class"] },
              "minContains": 1
            },
            {
              "contains": { "properties": { "variant_class": { "const": "delimiter_or_encoding" } }, "required": ["variant_class"] },
              "minContains": 1
            },
            {
              "contains": { "properties": { "variant_class": { "const": "fragmentation" } }, "required": ["variant_class"] },
              "minContains": 1
            },
            {
              "contains": { "properties": { "variant_class": { "const": "mixed_language" } }, "required": ["variant_class"] },
              "minContains": 1
            }
          ]
        },
        "rule_surface": {
          "type": "array",
          "description": "本子集声称覆盖的检测规则 id 全集：8 条 injection_detector 高危规则 + 2 条低危规则 + memory_validators.detect_submission 的 memory_authority_override。每条 id MUST 至少有一条用例以其 `pattern` 覆盖（见顶层 allOf）。",
          "minItems": 11,
          "maxItems": 11,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/detectorRuleId" }
        },
        "binding": {
          "type": "string",
          "minLength": 1,
          "description": "用例 `variant_id` 与条目 id 的绑定说明（`<version>#<variant_class>`）。冻结早于本次修订的用例正文按 FR-010 保持逐字节不变、故不带 `variant_id`，其 id 清单记录在 `amendment.frozen_unannotated_variant_case_ids`。"
        },
        "known_misses": {
          "type": "array",
          "description": "已知漏检变种（残余检测器局限的机器可读披露）：这些变种 MUST NOT 进入 `cases[]`（否则破坏冻结子集 100% 拦截水位），MUST 由判定程序如实记为未通过 / 未拦截（criterion_met=false）。",
          "minItems": 1,
          "items": { "$ref": "#/$defs/knownMiss" }
        }
      },
      "required": ["version", "entries", "rule_surface", "binding", "known_misses"]
    },
    "variantDictionaryEntry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "variant_class": { "$ref": "#/$defs/variantClassName" },
        "definition": { "type": "string", "minLength": 1 },
        "min_cases": { "type": "integer", "minimum": 1 }
      },
      "required": ["variant_class", "definition", "min_cases"]
    },
    "variantClassName": {
      "enum": ["synonym", "delimiter_or_encoding", "fragmentation", "mixed_language"]
    },
    "detectorRuleId": {
      "enum": [
        "chat_delimiter_escape",
        "delimiter_escape",
        "role_hijack",
        "role_hijack_zh",
        "identity_override",
        "prompt_disclosure",
        "tool_call_manipulation",
        "user_concealment",
        "suspicious_base64",
        "jailbreak_marker",
        "memory_authority_override"
      ]
    },
    "knownMiss": {
      "type": "object",
      "description": "已披露的未命中变种：必须是真实检测结果（risk_level=none、status=active、matched_patterns 为空），使残余局限可复算、可追溯。",
      "additionalProperties": false,
      "properties": {
        "miss_id": { "type": "string", "pattern": "^miss_[a-z0-9_]+$" },
        "variant_class": { "$ref": "#/$defs/variantClassName" },
        "language": { "enum": ["zh", "en"] },
        "content": { "type": "string", "minLength": 1 },
        "observed_risk_level": { "const": "none" },
        "observed_status": { "const": "active" },
        "observed_matched_patterns": { "type": "array", "maxItems": 0, "items": { "type": "string" } },
        "reason": { "type": "string", "minLength": 1 },
        "evidence": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      },
      "required": [
        "miss_id",
        "variant_class",
        "language",
        "content",
        "observed_risk_level",
        "observed_status",
        "observed_matched_patterns",
        "reason"
      ]
    },
    "amendment": {
      "type": "object",
      "description": "FR-007/FR-010 追加修订记录：既有条目逐字节未变（以 `previous_case_hashes` 逐条复算证明），被追加的条目 id、追加前的用例数与 `snapshot_hash` 一并登记，使『只增不破坏』可复算。",
      "additionalProperties": false,
      "properties": {
        "appended_at": { "type": "string", "format": "date-time" },
        "appended_case_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^poison_[a-z0-9_]+$" }
        },
        "previous_case_count": { "type": "integer", "minimum": 0 },
        "previous_snapshot_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "previous_case_hashes": {
          "type": "object",
          "description": "追加前每条既有用例的 canonical sha256（键为 case_id）。既有条目 MUST NOT 被删改，故这些哈希在修订后 MUST 逐条复算一致。",
          "minProperties": 1,
          "propertyNames": { "type": "string", "pattern": "^poison_[a-z0-9_]+$" },
          "additionalProperties": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        },
        "existing_cases_unchanged": { "const": true },
        "frozen_unannotated_variant_case_ids": {
          "type": "array",
          "items": { "type": "string", "pattern": "^poison_[a-z0-9_]+$" }
        },
        "first_covered_rule_ids": { "type": "array", "items": { "$ref": "#/$defs/detectorRuleId" } },
        "authority_alternatives_added": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "known_miss_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "reason": { "type": "string", "minLength": 1 },
        "evidence_paths": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      },
      "required": [
        "appended_at",
        "appended_case_ids",
        "previous_case_count",
        "previous_snapshot_hash",
        "previous_case_hashes",
        "existing_cases_unchanged",
        "frozen_unannotated_variant_case_ids",
        "reason"
      ]
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "case_id": { "type": "string", "pattern": "^poison_[a-z0-9_]+$" },
        "role": { "enum": ["primary", "control"] },
        "pattern": {
          "type": "string",
          "description": "用例声明的检测规则 id（或 `none` 表示无命中对照）。非 `none` 的声明 MUST 在该用例上真实命中，否则覆盖虚报（由回归/契约测试反向核对 `matched_patterns`）。",
          "enum": [
            "chat_delimiter_escape",
            "delimiter_escape",
            "role_hijack",
            "role_hijack_zh",
            "identity_override",
            "prompt_disclosure",
            "tool_call_manipulation",
            "user_concealment",
            "memory_authority_override",
            "suspicious_base64",
            "jailbreak_marker",
            "none"
          ]
        },
        "risk_tier": { "enum": ["high", "low", "none"] },
        "variant_class": {
          "description": "非空时 MUST 为 `variant_dictionary.entries` 已声明的四类之一；两份枚举由 schema 固定为同一集合，且字典条目逐类 const 强制，故不得声明字典外类别。",
          "type": ["string", "null"],
          "enum": ["synonym", "delimiter_or_encoding", "fragmentation", "mixed_language", null]
        },
        "variant_id": {
          "description": "该变种用例所属字典条目的 id，形如 `015.variants.1#<variant_class>`；与 `variant_class` 的配对由本 $defs 的 allOf 逐类强制。",
          "type": ["string", "null"],
          "enum": [
            "015.variants.1#synonym",
            "015.variants.1#delimiter_or_encoding",
            "015.variants.1#fragmentation",
            "015.variants.1#mixed_language",
            null
          ]
        },
        "language": { "enum": ["zh", "en"] },
        "target_scope": { "type": "string", "minLength": 1 },
        "content": { "type": "string", "minLength": 1 },
        "authority_escalation_phrasing": { "type": "boolean" },
        "assertions": {
          "type": "array",
          "minItems": 8,
          "uniqueItems": true,
          "items": {
            "enum": [
              "write_flagged",
              "write_quarantined",
              "default_recall_absent",
              "consolidation_input_absent",
              "attachment_absent",
              "working_set_absent",
              "control_surface_unchanged",
              "no_inconsistent_marking"
            ]
          }
        },
        "_meta": {
          "type": "object",
          "properties": {
            "review_status": { "enum": ["reviewed"] },
            "review_notes": { "type": "string", "minLength": 1 },
            "grounded_source": { "type": "string", "minLength": 1 }
          },
          "required": ["review_status", "review_notes", "grounded_source"],
          "additionalProperties": true
        }
      },
      "required": [
        "case_id",
        "role",
        "pattern",
        "risk_tier",
        "variant_class",
        "language",
        "target_scope",
        "content",
        "authority_escalation_phrasing",
        "assertions",
        "_meta"
      ],
      "allOf": [
        {
          "description": "变种 id 绑定：声明 synonym 的用例若带 variant_id，则 MUST 恰为 `015.variants.1#synonym`（其余三类同理）。",
          "if": { "properties": { "variant_class": { "const": "synonym" } }, "required": ["variant_class"] },
          "then": { "properties": { "variant_id": { "const": "015.variants.1#synonym" } } }
        },
        {
          "if": { "properties": { "variant_class": { "const": "delimiter_or_encoding" } }, "required": ["variant_class"] },
          "then": { "properties": { "variant_id": { "const": "015.variants.1#delimiter_or_encoding" } } }
        },
        {
          "if": { "properties": { "variant_class": { "const": "fragmentation" } }, "required": ["variant_class"] },
          "then": { "properties": { "variant_id": { "const": "015.variants.1#fragmentation" } } }
        },
        {
          "if": { "properties": { "variant_class": { "const": "mixed_language" } }, "required": ["variant_class"] },
          "then": { "properties": { "variant_id": { "const": "015.variants.1#mixed_language" } } }
        }
      ]
    }
  },
  "allOf": [
    {
      "description": "primary 用例必须是高危档，否则『标记且隔离』判据不可能满足。",
      "properties": {
        "cases": {
          "items": {
            "if": { "properties": { "role": { "const": "primary" } }, "required": ["role"] },
            "then": { "properties": { "risk_tier": { "const": "high" } } }
          }
        }
      }
    },
    {
      "description": "FR-002/FR-007 逐类变种覆盖与中文覆盖：四类冻结变种字典各 MUST 至少 1 条 primary 变种用例（删除任一类即拒绝），且至少 1 条中文用例。",
      "properties": {
        "cases": {
          "allOf": [
            {
              "contains": {
                "properties": { "role": { "const": "primary" }, "variant_class": { "const": "synonym" } },
                "required": ["role", "variant_class"]
              },
              "minContains": 1
            },
            {
              "contains": {
                "properties": { "role": { "const": "primary" }, "variant_class": { "const": "delimiter_or_encoding" } },
                "required": ["role", "variant_class"]
              },
              "minContains": 1
            },
            {
              "contains": {
                "properties": { "role": { "const": "primary" }, "variant_class": { "const": "fragmentation" } },
                "required": ["role", "variant_class"]
              },
              "minContains": 1
            },
            {
              "contains": {
                "properties": { "role": { "const": "primary" }, "variant_class": { "const": "mixed_language" } },
                "required": ["role", "variant_class"]
              },
              "minContains": 1
            },
            {
              "contains": { "properties": { "language": { "const": "zh" } }, "required": ["language"] },
              "minContains": 1
            }
          ]
        }
      }
    },
    {
      "description": "FR-002/FR-007 检测规则面覆盖：`variant_dictionary.rule_surface` 声明的 11 条规则 id 各 MUST 至少 1 条用例以其 `pattern` 覆盖；删除任一条规则的用例即拒绝。",
      "properties": {
        "cases": {
          "allOf": [
            {
              "contains": { "properties": { "pattern": { "const": "chat_delimiter_escape" } }, "required": ["pattern"] },
              "minContains": 1
            },
            {
              "contains": { "properties": { "pattern": { "const": "delimiter_escape" } }, "required": ["pattern"] },
              "minContains": 1
            },
            {
              "contains": { "properties": { "pattern": { "const": "role_hijack" } }, "required": ["pattern"] },
              "minContains": 1
            },
            {
              "contains": { "properties": { "pattern": { "const": "role_hijack_zh" } }, "required": ["pattern"] },
              "minContains": 1
            },
            {
              "contains": { "properties": { "pattern": { "const": "identity_override" } }, "required": ["pattern"] },
              "minContains": 1
            },
            {
              "contains": { "properties": { "pattern": { "const": "prompt_disclosure" } }, "required": ["pattern"] },
              "minContains": 1
            },
            {
              "contains": { "properties": { "pattern": { "const": "tool_call_manipulation" } }, "required": ["pattern"] },
              "minContains": 1
            },
            {
              "contains": { "properties": { "pattern": { "const": "user_concealment" } }, "required": ["pattern"] },
              "minContains": 1
            },
            {
              "contains": { "properties": { "pattern": { "const": "suspicious_base64" } }, "required": ["pattern"] },
              "minContains": 1
            },
            {
              "contains": { "properties": { "pattern": { "const": "jailbreak_marker" } }, "required": ["pattern"] },
              "minContains": 1
            },
            {
              "contains": { "properties": { "pattern": { "const": "memory_authority_override" } }, "required": ["pattern"] },
              "minContains": 1
            }
          ]
        }
      }
    },
    {
      "description": "`variant_dictionary.version` MUST 与 `frozen.variant_dictionary` 登记的版本一致（字典版本是冻结记录的一部分）。",
      "properties": {
        "frozen": { "properties": { "variant_dictionary": { "const": "015.variants.1" } } },
        "variant_dictionary": { "properties": { "version": { "const": "015.variants.1" } } }
      }
    }
  ]
}
